# انسخ هذا الملف إلى /var/www/shabik/backend/.env.production ثم عدّل القيم الحساسة.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=غيّر_هذه_القيمة_إلى_مفتاح_عشوائي_طويل_وفريد
DJANGO_ALLOWED_HOSTS=shopik.alattab.site,www.shopik.alattab.site,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://shopik.alattab.site,https://www.shopik.alattab.site
CSRF_TRUSTED_ORIGINS=https://shopik.alattab.site,https://www.shopik.alattab.site
DJANGO_TIME_ZONE=Asia/Aden
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/var/www/shabik/backend/db.sqlite3
PYTHONUNBUFFERED=1
