[Unit]
Description=Shabik Django Marketplace API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/shabik/backend
EnvironmentFile=/var/www/shabik/backend/.env.production
ExecStart=/var/www/shabik/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:5015 --workers 3 --timeout 120 --access-logfile - --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# تثبيت الملف:
# sudo cp deploy/shabik-django.service /etc/systemd/system/shabik-django.service
# sudo systemctl daemon-reload
# sudo systemctl enable --now shabik-django
# sudo systemctl status shabik-django

# إذا كان مسار المشروع مختلفًا، عدّل WorkingDirectory وEnvironmentFile وExecStart قبل التثبيت.
