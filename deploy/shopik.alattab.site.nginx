server {
    listen 80;
    listen [::]:80;
    server_name shopik.alattab.site www.shopik.alattab.site;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name shopik.alattab.site www.shopik.alattab.site;

    client_max_body_size 100M;

    ssl_certificate /etc/letsencrypt/live/shopik.alattab.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shopik.alattab.site/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # نسخة العميل المصدرة من Expo Web
    location / {
        root /var/www/shabik/dist-web/customer;
        try_files $uri $uri/ /index.html;
    }

    # REST API وDjango Admin
    location ~ ^/(api|admin)/ {
        proxy_pass http://127.0.0.1:5015;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60;
        proxy_send_timeout 120;
        proxy_read_timeout 120;
    }

    # ملفات Django الثابتة وملفات لوحة الإدارة
    location /static/ {
        alias /var/www/shabik/backend/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # صور وملفات المنتجات المرفوعة
    location /media/ {
        alias /var/www/shabik/backend/media/;
        expires 7d;
        add_header Cache-Control "public";
    }
}

# ملاحظة:
# إذا كان frontend سيعمل من نفس النطاق، فهذا الملف يعرض نسخة العميل.
# نسخة التاجر تُبنى إلى dist-web/vendor ويمكن نشرها على نطاق فرعي منفصل
# مثل vendor.shopik.alattab.site أو خلف مسار مخصص بعد تجهيز build مستقل.
