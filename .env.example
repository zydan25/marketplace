# رابط REST API الخاص بخادم Django
EXPO_PUBLIC_DJANGO_API_URL=https://your-domain.example.com

# اختر customer أو vendor عند البناء
APP_VARIANT=customer

# إعدادات Django على الخادم
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-the-existing-project-secret
SERVICES_CREDENTIALS_KEY=replace-with-the-existing-services-encryption-key
REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Aden

# قاعدة البيانات — لا تغيّر القيم الحالية عند استخدام PostgreSQL
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=backend/db.sqlite3

# إعدادات اختيارية
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
