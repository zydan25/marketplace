# رابط REST API الخاص بخادم Django
EXPO_PUBLIC_DJANGO_API_URL=https://your-domain.example.com

# اختر customer أو vendor عند البناء
APP_VARIANT=customer

# إعدادات Django على الخادم
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-the-existing-project-secret
SERVICES_CREDENTIALS_KEY=replace-with-the-existing-services-encryption-key
REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Aden

# PostgreSQL — يفضّل استخدام DATABASE_URL في Render أو أي مزود تشغيل.
# مثال خادم قاعدة البيانات الخاص بالـMarketplace:
DATABASE_URL=postgresql://marketplace:<PASSWORD>@alattab.site:5432/marketplace
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60

# بديل DATABASE_URL عند الحاجة لاتصال منفصل بالحقول:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=marketplace
# DB_USER=marketplace
# DB_PASSWORD=<PASSWORD>
# DB_HOST=alattab.site
# DB_PORT=5432

# إعدادات اختيارية
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
